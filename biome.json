{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error" },
      "style": { "useImportType": "error" },
      "correctness": { "noUnusedVariables": "error" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "files": {
    "maxSize": 67108864,
    "ignore": [
      "node_modules",
      "dist",
      "coverage",
      "**/*.txt",
      "tools/forge-bridge/__golden_java__",
      "tools/forge-bridge/__capture_logs__",
      "tools/forge-bridge/scenarios",
      "tools/forge-bridge/scripts/gen-*.mjs",
      "tools/forge-bridge/scripts/server-batch.mjs",
      "tools/forge-bridge/scripts/recapture-batch.mjs",
      "tools/forge-bridge/scripts/recapture-parallel.mjs",
      "tools/forge-bridge/scripts/revert-fails.mjs",
      "tools/forge-bridge/scripts/convert-in-hand.mjs",
      "tools/forge-bridge/scripts/export-scenarios.mjs",
      "packages/game/test/golden/__golden__",
      "docs/api"
    ]
  },
  "overrides": [
    {
      "include": ["packages/game/test/golden/scenarios.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
