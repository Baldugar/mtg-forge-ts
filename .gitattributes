# Force LF line endings on all text files so CI (Linux + macOS) sees the same
# bytes Windows committers do. Biome's formatter is line-ending-strict and
# autocrlf-converted CR characters trip the format check.
* text=auto eol=lf

# Treat scripts and config explicitly as text-LF.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Forge bridge JSONs are golden-trace fixtures; lock to LF for reproducibility.
*.scenario.json text eol=lf
*.golden.json text eol=lf
*.golden.java.json text eol=lf

# Binary artifacts left as-is.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
