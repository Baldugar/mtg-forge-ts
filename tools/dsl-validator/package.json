{
  "name": "@mtg-forge-ts/dsl-validator",
  "version": "0.0.0",
  "description": "Semantic validator for parsed Forge card definitions — verifies handler keys exist in game-package registries.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli.ts"
  },
  "dependencies": {
    "@mtg-forge-ts/core": "workspace:*",
    "@mtg-forge-ts/cards": "workspace:*",
    "@mtg-forge-ts/game": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
